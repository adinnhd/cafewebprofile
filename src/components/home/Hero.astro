---
import { Picture } from 'astro:assets';
import coffee from '../../assets/photos/coffee-ritual.jpg';
import Icon from '../ui/Icon.astro';
import { business } from '../../data/business';
---
<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow hero-eyebrow"><span></span> YOUR NEIGHBORHOOD COFFEE SPOT · CIREBON</p>
    <h1 id="hero-title">Secangkir jeda,<br /><em>sepanjang cerita.</em></h1>
    <p class="hero-description">Secangkir kopi, obrolan yang mengalir, dan tempat untuk menikmati waktu tanpa terburu-buru.</p>
    <div class="hero-actions"><a class="button button-olive" href="/menu">Jelajahi Menu<Icon name="arrow-up-right" /></a><a class="text-link" href={business.maps} target="_blank" rel="noopener noreferrer">Petunjuk Arah<Icon name="arrow-up-right" size={18} /></a></div>
    <div class="hero-footnote"><span class="tiny-triangle" aria-hidden="true"></span><p>Ruang kecil untuk<br /><strong>cerita-cerita besar.</strong></p><span class="hero-footnote-line"></span><span class="hero-coordinates">SUTAWINANGUN<br />CIREBON, JAWA BARAT</span></div>
  </div>
  <div class="hero-visual">
    <div class="hero-image-wrap">
      <Picture src={coffee} formats={['avif', 'webp']} widths={[480, 720, 1000, 1400]} sizes="(max-width: 767px) 100vw, 50vw" width={760} height={820} alt="Ilustrasi ritual menyeduh kopi dengan tangan dan alat pour-over di meja kayu" loading="eager" fetchpriority="high" class="hero-image" />
      <div class="photo-note"><span class="photo-note-dot"></span>A good cup. A slower moment.</div>
    </div>
    <div class="coffee-seal" role="img" aria-label="Kopi, cerita, jeda — simbol Tiga Segi Coffee. Take your time."><span>KOPI · CERITA · JEDA</span><svg class="coffee-seal-mark" width="43" height="40" viewBox="245 189 763 658" aria-hidden="true"><!-- Viewport crops the supplied logo to its triangle, excluding the wordmark. --><image href="/logo-tigasegi.png" x="0" y="0" width="1254" height="1254" /></svg><span>TAKE YOUR TIME</span></div>
    <span class="hero-image-caption">01 / THE EVERYDAY RITUAL <span>VISUAL KONSEP</span></span>
  </div>
</section>
<div class="manifesto-strip"><div class="container"><span>Good coffee.</span><span class="strip-triangle" aria-hidden="true">△</span><span>Good company.</span><span class="strip-triangle" aria-hidden="true">△</span><span>Your kind of place.</span><a href="#tentang" aria-label="Kenali Tiga Segi"><Icon name="arrow-down" size={20} /></a></div></div>
