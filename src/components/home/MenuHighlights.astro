---
import MenuCard from '../menu/MenuCard.svelte';
import Icon from '../ui/Icon.astro';
import { getDisplayMenu } from '../../lib/menu-images';
const featured = (await getDisplayMenu()).filter((item) => item.featured);
---
<section class="highlights-section section-space" aria-labelledby="highlights-title"><div class="container">
  <div class="section-heading"><div><p class="eyebrow section-label"><span>02</span> PILIHAN MENU</p><h2 id="highlights-title">Teman untuk <em>setiap suasana.</em></h2></div><a class="text-link" href="/menu">Lihat Semua Menu<Icon name="arrow-up-right" size={19} /></a></div>
  <p class="section-intro">Dari kopi yang akrab sampai camilan untuk dibagi. Temukan pilihanmu.</p>
  <div class="highlights-grid">{featured.map((item) => <MenuCard item={item} preview />)}</div>
  <p class="menu-reference-note">*Harga referensi historis, belum diverifikasi. Foto merupakan ilustrasi; produk asli dapat berbeda.</p>
</div></section>
